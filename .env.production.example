# Production: Render → evincus → Environment. Template only: fill the blanks in Render, never commit real values.
ENVIRONMENT=production
# Persistent disk. Anywhere else, every deploy wipes orders, subscribers and sales.
KV_PATH=/var/data/kv.sqlite3
# Email links and images. The API is same-origin, so no ALLOWED_ORIGINS.
SITE_URL=https://evincus.shop
API_URL=https://evincus.shop
# main.js refuses to boot production with anything but none for now.
PAYMENT_MODE=none
# Live PayPal, once PAYMENT_MODE=paypal is allowed. Anything but "live" calls the sandbox.
# PAYPAL_ENV=live
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
SHIPPING_USD=0
# Comma-separated ISO country codes that can't get delivery. Blank: none excluded.
DELIVERY_EXCLUDED_COUNTRIES=
# Order notices, alerts and the daily digest.
OWNER_EMAIL=
# Must be on the domain verified in Resend.
EMAIL_FROM=Evincus <no-reply@evincus.shop>
# Live Resend key: receipts, owner emails and the newsletter.
RESEND_API_KEY=
# Local hour (0-23) the newsletter goes out. Blank turns it off.
NEWSLETTER_HOUR=10
# Physical mailing address in the newsletter footer (CAN-SPAM).
POSTAL_ADDRESS=
# Report-only until the production browser checks pass; enforce after rollout.
CSP_MODE=report-only
# live | maintenance | stocking. Anything but live shows a 503 page on evincus.shop; onrender.com always shows the store.
STATUS=stocking
# Secrets: 32+ characters, all three different. Generate each with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=
ORDER_HMAC_KEY=
# Changing it breaks every confirm/unsubscribe link already sent.
NEWSLETTER_KEY=
# Never set in production: EMAIL_DISABLED, EMAIL_TEST_RECIPIENT, KEEPALIVE_URL. Render sets PORT and RENDER itself.
