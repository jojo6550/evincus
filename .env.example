# Copy to .env for npm run dev. .env is gitignored: never commit it.
ENVIRONMENT=development
SITE_URL=http://localhost:8000
API_URL=http://localhost:8000
OWNER_EMAIL=you@example.com
EMAIL_FROM=Evincus <no-reply@evincus.shop>
# Blank turns the newsletter off locally.
NEWSLETTER_HOUR=
NEWSLETTER_KEY=local-dev-only
# npm run discount sends this to the server; both read it from here locally.
ADMIN_TOKEN=local-dev-only
# Blank: emails fail and are logged instead of sent.
RESEND_API_KEY=
# Report-only until the production browser checks pass; enforce after rollout.
CSP_MODE=report-only
# Restore/load tests must disable outbound email. Optional test recipient rejects
# all other recipients rather than forwarding customer information elsewhere.
EMAIL_DISABLED=true
EMAIL_TEST_RECIPIENT=
# live | maintenance | stocking. Anything but live shows a 503 page on every host except *.onrender.com.
STATUS=live
# Catalog photo directory (gitignored). Never leave it blank: that would write photos into the repo root.
MEDIA_PATH=.media
# On hand per variant when an empty KV is first seeded from data/eras. 0 shows everything sold out.
SEED_STOCK=10
