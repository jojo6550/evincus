{
  "name": "evincus",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-timeout=120000",
    "start": "node main.js",
    "dev": "node --env-file-if-exists=.env --watch main.js",
    "error": "node scripts/error.mjs",
    "test-email": "node --env-file-if-exists=.env scripts/send-test-email.mjs",
    "new-era": "node scripts/new-era.mjs",
    "photos": "node scripts/photos.mjs",
    "icons": "node scripts/icons.mjs",
    "discount": "node scripts/discount.mjs",
    "add-viewer": "node --env-file-if-exists=.env scripts/viewers.mjs add",
    "remove-viewer": "node --env-file-if-exists=.env scripts/viewers.mjs remove",
    "list-viewers": "node --env-file-if-exists=.env scripts/viewers.mjs list",
    "inventory:pull": "node --env-file-if-exists=.env scripts/inventory-pull.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "check:security": "node scripts/security-check.mjs",
    "check:performance": "node scripts/performance-check.mjs",
    "check:load": "node scripts/load-check.mjs",
    "check:restore": "node scripts/restore-check.mjs --fixture",
    "encrypt-orders": "node --env-file-if-exists=.env scripts/encrypt-orders.mjs"
  },
  "dependencies": {
    "@deno/kv": "^0.14.0"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
